# The source types the database files under application/ rather than under
# text/. Binary types filed there are deliberately absent — x-executable,
# x-python-bytecode, x-sqlite2 — and so is x-desktop, where opening a desktop
# entry means running it rather than editing it.
application/json=nvim-foot.desktop
application/toml=nvim-foot.desktop
application/yaml=nvim-foot.desktop
application/xml=nvim-foot.desktop
application/x-shellscript=nvim-foot.desktop
application/x-ruby=nvim-foot.desktop
application/x-perl=nvim-foot.desktop
application/x-php=nvim-foot.desktop

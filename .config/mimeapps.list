# Documents, in Zathura. The org.pwmt.zathura-pdf-mupdf entry is the one that
# declares these types; org.pwmt.zathura.desktop declares none at all. Zathura's
# entry also claims image/png, image/jpeg, image/bmp, image/tiff and
# image/svg+xml — those stay with Loupe above, since Zathura's image support
# exists to render pages, not to be where a photo opens.
application/pdf=org.pwmt.zathura-pdf-mupdf.desktop
application/oxps=org.pwmt.zathura-pdf-mupdf.desktop
application/epub+zip=org.pwmt.zathura-pdf-mupdf.desktop
application/x-fictionbook=org.pwmt.zathura-pdf-mupdf.desktop
application/x-mobipocket-ebook=org.pwmt.zathura-pdf-mupdf.desktop

# Office documents, in LibreOffice. Each block is the MimeType= line of the
# named component's own packaged entry at LibreOffice 26.2.6.1, less the types
# this file already answers for — so the list cannot claim a format LibreOffice
# will not open. The Start Center entry is deliberately not named: it declares
# only application/vnd.openofficeorg.extension and the x-scheme-handler/ms-*
# schemes, so naming it for .docx would claim a type its own entry does not.
#
# application/clarisworks is declared by Writer, Calc and Draw, and
# application/vnd.ms-works by Writer and Calc; both are listed once, under
# Writer. A type under two entries records no decision — the resolver answers
# with whichever line it read last.
#
# Five types appear that no MimeType= line lists: application/x-docbook+xml,
# application/vnd.stardivision.writer, application/vnd.dbf, image/emf and
# image/wmf. The entries list only the aliases of these, and
# /usr/share/mime/aliases gives these as the canonical names — the same reason
# Markdown appears twice above, since glob resolution and content resolution
# can return different names for one file.

# Word processor documents, in LibreOffice Writer. text/plain and
# application/x-extension-txt are claimed by this entry and left with Neovim
# above: a .txt file belongs in the editor.
application/clarisworks=libreoffice-writer.desktop
application/docbook+xml=libreoffice-writer.desktop
application/macwriteii=libreoffice-writer.desktop
application/msword=libreoffice-writer.desktop
application/prs.plucker=libreoffice-writer.desktop
application/rtf=libreoffice-writer.desktop
application/vnd.apple.pages=libreoffice-writer.desktop
application/vnd.lotus-wordpro=libreoffice-writer.desktop
application/vnd.ms-word=libreoffice-writer.desktop
application/vnd.ms-word.document.macroEnabled.12=libreoffice-writer.desktop
application/vnd.ms-word.template.macroEnabled.12=libreoffice-writer.desktop

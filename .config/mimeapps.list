# Which application opens what, when a file is opened from outside a shell —
# from Nautilus, from a Chrome download, or through xdg-open.
#
# Tracked because this file is rewritten in place by any program that offers to
# become the default for a type. Untracked, the session's defaults are whatever
# the last such prompt left behind, and a clone gets none of them.
#
# Text goes to .local/share/applications/neovide.desktop, which is tracked
# beside this file and carries its own explanation. Images go to Loupe and
# documents to Zathura, both packaged entries named here and not copied.

[Default Applications]

# Web content and URL schemes. text/html stays here: a saved page is something
# to view rather than edit, and it is the one text type the browser answers for.
text/html=google-chrome.desktop
x-scheme-handler/http=google-chrome.desktop
x-scheme-handler/https=google-chrome.desktop
x-scheme-handler/about=google-chrome.desktop
x-scheme-handler/unknown=google-chrome.desktop
x-scheme-handler/claude-cli=claude-code-url-handler.desktop
x-scheme-handler/mailto=google-chrome.desktop

# Text, in Neovide. A file reached from outside a shell is reached from a
# graphical session, so it goes to the entry that draws its own window rather
# than to nvim-foot.desktop, which wraps Neovim in a foot terminal. That entry
# stays tracked beside this file and is what this block names again if Neovide
# is ever not installed; nothing points at it while these lines stand.
#
# Every type the shared MIME database files under text/, less
# text/html above. The media type is not a guide to what is text — the database
# files Rust under text/rust and Go under text/x-go, Ruby under
# application/x-ruby and Python under text/x-python — so this is the whole
# media type rather than a prefix, and the source types filed under
# application/ are listed after it.
#
# Markdown appears as two types on purpose: resolution by filename glob gives
# text/markdown and resolution by content gives text/plain, because a Markdown
# file is plain text and its magic says so. GIO globs, file(1) inspects, so
# mapping one of them leaves the other caller broken.
text/cache-manifest=neovide.desktop
text/calendar=neovide.desktop
text/css=neovide.desktop
text/csv=neovide.desktop
text/csv-schema=neovide.desktop
text/enriched=neovide.desktop
text/htmlh=neovide.desktop
text/javascript=neovide.desktop
text/jscript.encode=neovide.desktop
text/julia=neovide.desktop
text/markdown=neovide.desktop
text/org=neovide.desktop
text/plain=neovide.desktop
text/rfc822-headers=neovide.desktop
text/richtext=neovide.desktop
text/rust=neovide.desktop
text/sgml=neovide.desktop
text/spreadsheet=neovide.desktop
text/tab-separated-values=neovide.desktop
text/tcl=neovide.desktop

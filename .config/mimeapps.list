# The source types the database files under application/ rather than under
# text/. Binary types filed there are deliberately absent — x-executable,
# x-python-bytecode, x-sqlite2 — and so is x-desktop, where opening a desktop
# entry means running it rather than editing it.
application/json=neovide.desktop
application/toml=neovide.desktop
application/yaml=neovide.desktop
application/xml=neovide.desktop
application/x-shellscript=neovide.desktop
application/x-ruby=neovide.desktop

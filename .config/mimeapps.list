application/x-m4=nvim-foot.desktop
application/ecmascript=nvim-foot.desktop
application/json5=nvim-foot.desktop
application/sql=nvim-foot.desktop
application/xml-dtd=nvim-foot.desktop

# Images, in Loupe. The list is exactly the MimeType= line of
# /usr/share/applications/org.gnome.Loupe.desktop — naming a type Loupe does not
# declare would route a file to a viewer that cannot open it.
image/apng=org.gnome.Loupe.desktop
image/bmp=org.gnome.Loupe.desktop
image/gif=org.gnome.Loupe.desktop
image/jp2=org.gnome.Loupe.desktop
image/jpeg=org.gnome.Loupe.desktop
